                {
                  "t": "去核，用手剥掉表皮"
                },
                {
                  "t": "扣在菜板上45°斜切成片"
                }
              ]
            },
            {
              "name": "黄柠檬（切块）",
              "steps": [
                {
                  "t": "洗净，纵向切1分6",
