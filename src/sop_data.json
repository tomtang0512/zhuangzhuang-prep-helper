              "name": "老豆腐（切厚片）",
              "steps": [
                {
                  "t": "出品时拆盒，切厚片（约2cm厚度）"
                },
                {
                  "t": "剩余未使用部分泡水装盒冷藏储存"
                },
                {
                  "t": "注意冷藏温度 / 出品时检查有无异味",
                  "key": true
                }
              ]
            },
            {
              "name": "玉米（切四分块）",
              "steps": [
                {
                  "t": "去壳洗净"
                },
                {
                  "t": "切段（1根玉米约切3~4段），纵向1分4"
                },
                {
                  "t": "装盒冷藏储存备用"
                }
              ]
            }
          ]
        },
        {
          "name": "其他",
          "items": [
            {
              "name": "生菜（打底用）",
              "steps": [
                {
                  "t": "洗净，去根，弄散成单片叶状"
