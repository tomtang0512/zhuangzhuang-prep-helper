                },
                {
                  "t": "过凉水降温后泡水冷藏"
                },
                {
                  "t": "出品时剥壳，切蛋器一分为二"
                }
              ]
            }
          ]
        },
        {
          "name": "鲜蔬锅",
          "items": [
            {
              "name": "娃娃菜叶",
              "steps": [
                {
                  "t": "洗净，去根，弄散成单片叶状"
