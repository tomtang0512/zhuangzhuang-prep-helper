  "sections": [
    {
      "id": "cutting",
      "name": "切配&调料分装",
      "subtitle": "蔬菜类备货 + 调味分装操作标准",
      "redlines": [],
      "notes": [
        "蔬菜按纤体Easy碗/鲜蔬锅分区，按摆盘顺序依次置于冷藏柜：纤体Easy碗蔬菜放第二层（罗莎红生菜-苦苣-胡萝卜丝-紫甘蓝-水果玉米粒-刺黄瓜-樱桃萝卜-三色圣女果-溏心蛋）；鲜蔬锅蔬菜放第三层（金针菇-娃娃菜叶-胡萝卜片-玉米-西兰花）",
        "易变质类商品放到不常开的冷藏柜中储存（温度相对较低），例如开封后的豆腐",
        "分装瓶外部保持清爽，无油腻",
        "不同调味料分装瓶出品时必须对应贴相应贴纸（集中打印制作）",
        "汤包和椰浆均需要张贴标签"
      ],
      "groups": [
        {
          "name": "纤体Easy碗",
          "items": [
            {
              "name": "罗莎红生菜（撕小片）",
              "steps": [
                {
                  "t": "洗净，撕小片（不超过大拇指长度）"
                },
                {
                  "t": "装盒冷藏储存备用"
                }
              ]
            },
            {
              "name": "苦苣（去根茎，对半切）",
              "steps": [
                {
                  "t": "洗净，去根茎（留带叶处），切2-3段（每段不超过大拇指长度）"
                },
                {
                  "t": "装盒泡水冷藏储存备用"
                }
              ]
            },
            {
              "name": "胡萝卜（切丝）",
              "steps": [
                {
                  "t": "洗净，切除头尾"
                },
                {
                  "t": "机器切细丝"
                },
                {
                  "t": "装盒冷藏储存备用"
                }
              ]
            },
            {
              "name": "紫甘蓝（切丝）",
              "steps": [
                {
                  "t": "剥除表层烂叶，洗净"
                },
                {
                  "t": "机器切细丝"
                },
                {
                  "t": "装盒泡水冷藏储存备用"
                }
              ]
            },
            {
              "name": "甜玉米粒",
              "steps": [
                {
                  "t": "标品生玉米粒拆袋，煮熟"
                },
                {
                  "t": "过冷水后滤干"
                },
                {
                  "t": "装盒冷藏储存备用"
                }
              ]
            },
            {
              "name": "刺黄瓜（切片）",
              "steps": [
                {
                  "t": "洗净，切除头尾"
                },
                {
                  "t": "机器切厚片"
                },
                {
                  "t": "装盒泡水冷藏储存备用"
                }
              ]
            },
            {
              "name": "樱桃萝卜（切片）",
              "steps": [
                {
                  "t": "洗净，切除头尾"
                },
                {
                  "t": "机器切厚片"
                },
                {
                  "t": "装盒泡水冷藏储存备用"
                }
              ]
            },
            {
              "name": "三色圣女果（对半切）",
              "steps": [
                {
                  "t": "洗净，去蒂"
                },
                {
                  "t": "装盒冷藏储存备用"
                },
                {
                  "t": "出品时对半切"
                }
              ]
            },
            {
              "name": "溏心蛋（对半切）",
              "steps": [
                {
                  "t": "可生食鸡蛋冷水下锅煮，定时9分30秒",
                  "key": true
                },
                {
                  "t": "到时立即捞出过凉水，充分降温后装盒泡水冷藏储存备用"
                },
                {
                  "t": "出品时剥掉蛋壳，用切蛋器一分为二"
                }
              ],
              "note": "保存时注意卫生，避免长期直接暴露在空气中"
            }
          ]
        },
        {
          "name": "蛋白Pro碗",
          "items": [
            {
              "name": "杏鲍菇（切小块）",
              "steps": [
                {
                  "t": "洗净，去根"
                },
                {
                  "t": "纵向中间切，1分4，切小块"
                }
              ]
            },
            {
              "name": "西葫芦（切小块）",
              "steps": [
                {
                  "t": "洗净，去蒂"
                },
                {
                  "t": "纵向中间切，1分6（大的1分8），切小块"
                }
              ]
            },
            {
              "name": "西兰花（切小朵）",
              "steps": [
                {
                  "t": "洗净，切小朵（不超过大拇指长度）"
                }
              ]
            },
            {
              "name": "芦笋（去根）",
              "steps": [
                {
                  "t": "洗净，去根"
                },
                {
                  "t": "根部去除长度根据老嫩程度决定，参考保留约20cm长"
                }
              ]
            },
            {
              "name": "红黄彩椒（切圈）",
              "steps": [
                {
                  "t": "洗净，去蒂"
                },
                {
                  "t": "纵向中间切1分2，去籽"
                },
                {
                  "t": "横向切圈"
                }
              ]
            },
            {
              "name": "甜玉米粒",
              "steps": [
                {
                  "t": "标品生玉米粒拆袋，煮熟"
                },
                {
                  "t": "过冷水后滤干"
                },
                {
                  "t": "装盒冷藏储存备用"
                }
