                {
                  "t": "沿切面纹理刨片（刨肉机刻度1.5）"
                },
                {
                  "t": "逐片平铺在油纸上，装入密封袋或保鲜膜后冷冻保存"
                },
                {
                  "t": "出品时室温缓化，从油纸上逐片取下使用"
                }
              ]
            }
          ]
        },
