    {
      "id": "marinade",
      "name": "腌制",
      "subtitle": "腌制区备货清单及操作标准",
      "redlines": [],
      "notes": [
        "腌制肉类储藏在冷冻柜的上层冷藏区中，温度相对较低且稳定，利于储存"
      ],
      "groups": [
        {
          "name": "腌制前原料处理",
          "items": [
            {
              "name": "解冻与吸水",
              "steps": [
                {
                  "t": "去皮去骨鸡腿肉/鸡胸肉完全解冻（冷藏解冻）"
                },
                {
                  "t": "用厨房纸吸干表面水分"
                }
              ]
            },
            {
              "name": "精修标准",
              "steps": [
                {
                  "t": "无明显脂肪残留"
                },
                {
                  "t": "无大面积白色筋膜覆盖（鸡胸需剔除头尾两端的白筋）"
                },
                {
                  "t": "无淤血 / 变色肉"
                },
                {
                  "t": "无异味"
                }
              ]
            }
          ]
        },
        {
          "name": "腌制前备货要求",
          "items": [
            {
              "name": "切条（不腌制）",
              "steps": [
                {
                  "t": "预留部分去皮去骨鸡腿排（精修）做切条处理"
                },
                {
                  "t": "标准：约3cm宽长条形"
                },
                {
                  "t": "用途：冬阴功去皮鸡腿鲜蔬锅"
                }
              ]
            },
            {
              "name": "腌制用肉改刀",
              "steps": [
                {
                  "t": "腌制用的鸡腿肉做切块处理"
                },
                {
                  "t": "鸡胸肉做切片处理"
                }
              ]
            },
            {
              "name": "腌制品项",
              "steps": [
                {
                  "t": "基础腌制鸡腿排 —— 照烧鸡腿排 / 柠檬黑椒鸡腿排"
                },
                {
                  "t": "奥尔良鸡腿排"
                },
                {
                  "t": "地中海香草鸡胸肉"
                }
              ]
            }
          ]
        },
        {
          "name": "腌制配方（食材1200g基准）",
          "items": [
            {
              "name": "基础腌制",
              "steps": [
                {
                  "t": "食材1200g + 蚝油30g + 薄盐生抽30g + 生粉20g + 黑胡椒碎15g",
                  "key": true
                },
                {
                  "t": "规格有调整或当日二次腌制补货，按此配方对应计算配比"
                }
              ]
            },
            {
              "name": "奥尔良腌制",
              "steps": [
                {
                  "t": "食材1200g + 奥尔良腌料60g + 黑胡椒碎12g",
                  "key": true
                }
              ]
            },
            {
              "name": "地中海腌制",
              "steps": [
                {
                  "t": "基础腌制配方 + 地中海腌料20g",
                  "key": true
                }
              ]
            }
          ]
        },
        {
          "name": "出品前检查",
          "items": [
            {
              "name": "气味与颜色",
              "steps": [
                {
                  "t": "出品时特别留意肉的气味 / 颜色，判断是否变质",
                  "key": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "cooking",
      "name": "熟制",
      "subtitle": "店内熟制类食品清单及操作标准",
      "redlines": [],
      "notes": [],
      "groups": [
        {
          "name": "主食类",
          "items": [
            {
              "name": "七色糙米杂粮饭",
              "steps": [
                {
                  "t": "七色糙米取适量，冷水淘洗2~3遍，水色呈淡白色至基本清澈"
                },
                {
                  "t": "按比例加入纯净水浸泡约30min，放电饭煲底层，选择糙米饭模式烹饪"
                },
                {
                  "t": "糙米:水 = 1:1.2~1.5",
                  "key": true
                },
                {
                  "t": "冷藏复热：表面喷水3-5下，微波炉高火3-5min"
                }
              ]
            },
            {
              "name": "三色藜麦糙米饭",
              "steps": [
                {
                  "t": "三色藜麦取适量，冷水淘洗2~3遍"
                },
                {
                  "t": "按比例加纯净水，放电饭煲隔层上部，与糙米饭同时烹饪"
                },
                {
                  "t": "藜麦:水 = 1:1.2~1.5",
                  "key": true
                },
                {
                  "t": "蒸熟后三色藜麦与七色糙米按 4:6 比例混合搅拌",
                  "key": true
                },
                {
                  "t": "冷藏复热：表面喷水3-5下，微波炉高火3-5min"
                }
              ]
            },
            {
              "name": "烤贝贝南瓜",
              "steps": [
                {
                  "t": "清洗外皮至表皮干净，用刀切去顶部蒂头"
                },
                {
                  "t": "纵向对半切，用勺子挖去中间瓜籽，内壁刮平整"
                },
                {
                  "t": "每半球平均切成4块，两个半球共8块"
                },
                {
                  "t": "表面喷油，空气炸锅12min",
                  "key": true
                },
                {
                  "t": "冷藏复热：微波炉高火3-5min"
                }
              ],
              "note": "切面接触空气超过2小时会开始发干，不立即烤制需贴膜保存"
            },
            {
              "name": "蒸红薯",
              "steps": [
                {
                  "t": "清洗外皮至表皮干净，用刀切除修整头尾部"
                },
                {
                  "t": "根据大小切成1-2段，每段约4~5cm"
                },
                {
                  "t": "蒸锅≥30min",
                  "key": true
                },
                {
                  "t": "冷藏复热：微波炉高火3-5min"
                }
              ],
              "note": "切块后切面会氧化褐变，不立即蒸制需泡冷水保存，蒸前捞出沥干"
            }
          ]
        },
        {
          "name": "蔬菜类 · 蛋白Pro碗烤时蔬",
          "items": [
            {
              "name": "烤时蔬流程",
              "steps": [
                {
                  "t": "食材全部预处理（清洗 + 对应标准切配）"
                },
                {
                  "t": "按配方与调味料充分混合，无需腌制，抓拌均匀后直接进空气炸锅"
                },
                {
                  "t": "蔬菜配比 205g/份：杏鲍菇30±5 / 西葫芦30±5 / 西兰花60±5 / 芦笋25±5 / 彩椒30±5 / 甜玉米粒30±5",
                  "key": true
                },
                {
                  "t": "调料配方：480g蔬菜 + 20g橄榄油 + 5g黑胡椒碎 + 2g盐",
                  "key": true
                },
                {
                  "t": "烹饪后按配比提前分装储存，出品时微波炉复热，开盖中高火2分钟"
                },
                {
                  "t": "当天烤制当天出品，烤好的蔬菜不过夜",
                  "key": true
                },
                {
                  "t": "烤箱顺序：蔬菜不叠堆，最上层西兰花，第二层彩椒和芦笋，第三层杏鲍菇和西葫芦",
                  "key": true
                },
                {
                  "t": "西兰花单独处理：先焯水（开水加少量盐和油，约1min）再烤230°5min，常温保存、无需复热",
                  "key": true
                },
                {
                  "t": "冷藏复热：微波炉高火3-4min",
                  "key": true
                }
              ]
            },
            {
              "name": "杏鲍菇",
              "steps": [
                {
                  "t": "切配：纵向一分四，切小块"
                },
                {
                  "t": "烤制：烤箱230℃ 12-13min / 空气炸锅200℃ 10min",
                  "key": true
                }
              ]
            },
            {
              "name": "西葫芦",
              "steps": [
                {
                  "t": "切配：纵向一分四，切小块"
                },
                {
                  "t": "烤制：烤箱230℃ 11min / 空气炸锅200℃ 10min",
                  "key": true
                }
              ]
            },
            {
              "name": "西兰花",
              "steps": [
                {
                  "t": "切配：切小朵"
                },
                {
                  "t": "焯水：开水加少量盐和油，下入切好的西兰花焯水约1min，捞出沥干",
                  "key": true
                },
                {
                  "t": "烤制：烤箱230°5min",
                  "key": true
                },
                {
                  "t": "保存：常温保存，无需复热",
                  "key": true
                }
              ]
            },
            {
              "name": "芦笋",
              "steps": [
                {
                  "t": "切配：去根，保留约15-18cm长"
                },
                {
                  "t": "烤制：烤箱230℃ 11min / 空气炸锅200℃ 5min",
                  "key": true
                }
              ]
            },
            {
              "name": "红黄彩椒",
              "steps": [
                {
                  "t": "切配：去蒂，纵向一分二，去籽，横向切圈"
                },
                {
                  "t": "烤制：烤箱230℃ 11min / 空气炸锅200℃ 7min",
                  "key": true
                }
              ]
            }
          ]
        },
        {
          "name": "其他",
          "items": [
            {
              "name": "溏心蛋",
              "steps": [
                {
                  "t": "可生食鸡蛋冷水下锅煮，定时9分30秒",
                  "key": true
                },
                {
                  "t": "到时立即捞出过凉水充分降温，泡水置冷藏柜保存"
                },
                {
                  "t": "出品时剥壳，切蛋器一分为二"
                }
              ],
              "note": "保存时注意卫生，避免长期直接暴露在空气中"
            }
          ]
        },
        {
          "name": "肉类",
          "items": [
            {
              "name": "卤手枪腿",
              "steps": [
                {
                  "t": "去皮带骨鸡手枪腿 300±50g/个 充分化冻，去皮、剔大块油脂，表面改花刀"
                },
                {
                  "t": "冷水下锅加葱段、姜片、料酒中火焯水，水开后再煮10min，撇去浮沫，温水冲净",
                  "key": true
                },
                {
                  "t": "配比：食材500g + 香辣卤料48g + 纯净水500ml，先加料汁和水搅开，大火烧开",
                  "key": true
                },
                {
                  "t": "放入鸡腿，开锅后小火煮20min，关火浸泡1夜",
                  "key": true
                },
                {
                  "t": "放凉后再放冰箱冷藏；保鲜膜按单只分装，冷冻保存，避免粘连"
                },
                {
                  "t": "出餐复热：微波炉高火扣盖加热约5min，要热透，观察5min是否足够",
                  "key": true
                }
              ]
            },
            {
              "name": "卤牛腱",
              "steps": [
                {
                  "t": "整块牛腱子冷水下锅加葱段、姜片、料酒中火焯水，水开后再煮约30min，撇浮沫，温水冲净",
                  "key": true
                },
                {
                  "t": "配比：食材500g + 香辣卤料48g + 纯净水750ml，先加料汁和水搅开，大火烧开",
                  "key": true
                },
                {
                  "t": "放入牛腱子，开锅后小火煮≥1h，关火浸泡1夜",
                  "key": true
                },
                {
                  "t": "放凉后再冷藏；整块用保鲜膜紧缠，冷藏/冷冻定型（不能完全冻住，否则切不动）"
                },
                {
                  "t": "定型后拆膜，逆牛肉纹理切片"
                },
                {
                  "t": "保鲜膜按售卖规格分装，冷冻保存"
                },
                {
                  "t": "出餐复热：微波炉高火扣盖加热约2-3min，时间久了会变干",
                  "key": true
                }
              ]
            },
            {
              "name": "鱿鱼",
              "steps": [
                {
                  "t": "整条鱿鱼325g化冻，清洗表皮，去内脏及软骨，去眼睛及牙齿"
                },
                {
                  "t": "鱿鱼身切花刀（不切断），鱿鱼须一分四"
                },
                {
                  "t": "热水烫1遍，快速冲凉水后按单只分装，冷冻保存"
                }
              ]
            },
            {
              "name": "煎鸡腿肉",
              "steps": [
                {
                  "t": "生制熟比例 80%-85%，按肉量换算表取量",
                  "key": true
                },
                {
                  "t": "每100g肉用油 ≤10g（喷油瓶10喷，1g/喷）",
                  "key": true
                },
                {
                  "t": "照烧鸡腿：必须在出餐时回锅加入照烧汁",
                  "key": true
                },
                {
                  "t": "照烧汁比例：每160g生肉搭配20g照烧汁",
                  "key": true
                }
              ],
              "note": "照烧汁换算：80g→10g，100g→13g，140g→18g，160g→20g，250g→31g"
            },
            {
              "name": "煎鸡胸肉",
              "steps": [
                {
                  "t": "生制熟比例 85-90%，按肉量换算表取量",
                  "key": true
                },
                {
                  "t": "每100g肉用油 ≤10g（喷油瓶10喷，1g/喷）"
                }
              ]
            },
            {
              "name": "煎牛肉片",
              "steps": [
                {
                  "t": "生制熟比例 65-70%，按肉量换算表取量",
                  "key": true
                },
                {
                  "t": "每100g肉用油 ≤10g（喷油瓶10喷，1g/喷）"
                }
              ]
            },
            {
              "name": "虾仁",
              "steps": [
                {
                  "t": "数量按换算表：30g=2只 / 50g=3只 / 100g=7只 / 120g=8只",
                  "key": true
                },
                {
                  "t": "每100g肉用油 ≤10g（喷油瓶10喷，1g/喷）"
                }
              ]
            }
          ]
        },
        {
          "name": "卷饼类 & 恰巴塔",
          "items": [
            {
              "name": "墨西哥风味帕斯雀牛肉卷饼",
              "steps": [
                {
                  "t": "蔬菜基底配比：西红柿丁:洋葱丁:牛油果丁 = 200g:50g:1个牛油果",
                  "key": true
                },
                {
                  "t": "中火加热卷饼，两面各1min"
                },
                {
                  "t": "25g牛肉酱均匀涂抹 → 均匀摆放30g帕斯雀牛肉 → 铺1-2片生菜叶 → 生菜叶上均匀铺60g蔬菜基底 → 最上层再均匀铺30g帕斯雀牛肉片",
                  "key": true
                },
                {
                  "t": "出餐时微波炉中高火扣盖加热3-4min，加热后用锡纸二次包装出餐"
                }
              ]
            },
            {
              "name": "北非阿尔及利亚风味烟熏鸡肉卷饼",
              "steps": [
                {
                  "t": "蔬菜基底配比：西红柿丁:洋葱丁:牛油果丁 = 200g:50g:1个牛油果",
                  "key": true
                },
                {
                  "t": "中火加热卷饼，两面各1min"
                },
                {
                  "t": "20g阿尔及利亚酱均匀涂抹 → 均匀摆放30g烟熏鸡肉片 → 铺1-2片生菜叶 → 生菜叶上均匀铺60g蔬菜基底 → 最上层再均匀摆放30g烟熏鸡肉片",
                  "key": true
                },
                {
                  "t": "用油纸包裹住冷冻保存"
                },
                {
                  "t": "出餐时微波炉中高火扣盖加热3-4min，加热后用锡纸二次包装出餐"
                }
              ]
            },
            {
              "name": "帕斯雀牛肉恰巴塔",
              "steps": [
                {
                  "t": "恰巴塔复热：表面喷5下纯净水",
                  "key": true
                },
                {
                  "t": "微波中高火扣盖加热约3min至热透（扣盖防过干）",
                  "key": true
                },
                {
                  "t": "中间切开不切断，依次：冠利芥末青瓜酱15g → 生菜叶 → 帕斯雀牛肉片40g → 油浸小番茄撕条均匀摆放",
                  "key": true
                }
              ]
            }
          ]
        }
      ]
